#pragma kernel UpdateBoids
#pragma kernel AssignCells
#pragma kernel ClearCells
// #pragma kernel RadSortCells
#pragma kernel RadixClear
//#pragma kernel RadixHistogram
#pragma kernel RadixBlockHistogram
#pragma kernel RadixPrefixSum
//#pragma kernel RadixScatter
#pragma kernel RadixScatterStable
#pragma kernel BuildCellRanges

struct Boid
{
    float3 pos;
    float3 vel;
};

//update below
struct BoidCell
{
    uint boidIndex;
    uint cellIndex;
};

#define RADIX_BITS 3
#define RADIX_BUCKETS (1 << RADIX_BITS) // = 8
#define RADIX_MASK (RADIX_BUCKETS - 1) // = 7


RWStructuredBuffer<uint> CellStart;
RWStructuredBuffer<uint> CellEnd;
RWStructuredBuffer<uint> CellBucketCounts;

RWStructuredBuffer<Boid> Boids;
RWStructuredBuffer<BoidCell> BoidCells;
RWStructuredBuffer<BoidCell> BoidCellsTemp;

RWStructuredBuffer<uint> BucketCounts;   // 8 counters
RWStructuredBuffer<uint> BucketCounters; //atomic counters for scatter
RWStructuredBuffer<uint> BucketOffsets;  // prefix-summed offsets
RWStructuredBuffer<uint> BlockCounts;
RWStructuredBuffer<uint> BlockOffsets;

groupshared uint localCounts[RADIX_BUCKETS];
groupshared uint gs_Digits[256];


uint _Shift;

uint _NumBoids;
uint _NumGroups;
uint _NumCells;
uint _NullCell;
float _CellSize;
float _CellSeats;

float _NeighborRadius;
float _SeparationDistance;
float _SeparationWeight;
float _AlignmentWeight;
float _CohesionWeight;
float _MaxSpeed; 
float _MinSpeed;

float _DeltaTime;

RWTexture2D<float4> PositionMap;
RWTexture2D<float4> VelocityMap;
uint _TexWidth;

uint3 CellCord(float3 pos)
{
    int3 cellCord= int3(floor(pos / _CellSize));

    cellCord.x = clamp(cellCord.x, 0, _CellSeats - 1);
    cellCord.y = clamp(cellCord.y, 0, _CellSeats - 1);
    cellCord.z = clamp(cellCord.z, 0, _CellSeats - 1);

    return (uint3) cellCord;
}

uint FlattenCord(uint3 cord)
{
    return (cord.x) + (cord.y * _CellSeats) + (cord.z * _CellSeats * _CellSeats);
}

uint3 UnflattedCord(uint flatCord)
{
    uint3 cord;
    uint area = _CellSeats * _CellSeats;

    cord.z = flatCord / area;

    uint remainder = flatCord % area;

    cord.x = remainder % _CellSeats;
    cord.y = remainder / _CellSeats;

    return cord;
}

bool IsValidCell(int value)
{
    return value >= 0 && value < _CellSeats;
}


[numthreads(256, 1, 1)]
void AssignCells(uint id : SV_DispatchThreadID)
{
    if(id >= _NumBoids) return;

    Boid b = Boids[id];

    uint3 cellCord= CellCord(b.pos);

    uint flattenedCord = FlattenCord(cellCord);

    BoidCells[id].boidIndex = id;
    BoidCells[id].cellIndex = flattenedCord;
}


[numthreads(16, 1, 1)]
void ClearCells(uint id : SV_DispatchThreadID)
{
    if(id >= _NumCells) return;
    CellStart[id] = _NullCell;
    CellEnd[id] = _NullCell;
}


[numthreads(RADIX_BUCKETS,1,1)]
void RadixClear (uint id : SV_DispatchThreadID)
{
    if (id >= RADIX_BUCKETS) return;
    BucketCounts[id] = 0;
    BucketCounters[id] = 0;
    BucketOffsets[id] = 0;
    BlockCounts[id] = 0;
    BlockOffsets[id] = 0;
}

[numthreads(256,1,1)]
void RadixBlockHistogram(uint id : SV_GroupThreadID, uint3 g : SV_GroupID, uint3 dispatchId : SV_DispatchThreadID)
{
    uint globalId = dispatchId.x;

    for (uint i = id; i < RADIX_BUCKETS; i += 256)
        localCounts[i] = 0;
    GroupMemoryBarrierWithGroupSync();

    if (globalId < _NumBoids)
    {
        uint cell = BoidCells[globalId].cellIndex;
        uint digit = (cell >> _Shift) & RADIX_MASK;
        InterlockedAdd(localCounts[digit], 1);
    }
    GroupMemoryBarrierWithGroupSync();


    if (id == 0)
    {
        uint baseIndex = g.x * RADIX_BUCKETS;
        for (uint b = 0; b < RADIX_BUCKETS; ++b)
            BlockCounts[baseIndex + b] = localCounts[b];
    }
}

[numthreads(1,1,1)]
void RadixPrefixSum(uint id : SV_DispatchThreadID)
{
    uint globalOffset = 0;

    for (uint group = 0; group < _NumGroups; ++group)
    {
        uint base = group * RADIX_BUCKETS;

        for (uint digit = 0; digit < RADIX_BUCKETS; ++digit)
        {
            uint count = BlockCounts[base + digit];

            BlockOffsets[base + digit] = globalOffset;
            globalOffset += count;
        }
    }
}


[numthreads(256,1,1)]
void RadixScatterStable(uint id : SV_GroupThreadID, uint3 g : SV_GroupID, uint3 dispatchId : SV_DispatchThreadID)
{
    uint groupIndex = g.x;
    uint globalId = dispatchId.x;

    // 1. Calculate and store the digit for this thread
    uint digit = 0xFFFFFFFF; // Sentinel
    if (globalId < _NumBoids)
    {
        BoidCell bc = BoidCells[globalId];
        digit = (bc.cellIndex >> _Shift) & RADIX_MASK;
    }
    
    // Store in shared memory so other threads can read it
    gs_Digits[id] = digit;
    GroupMemoryBarrierWithGroupSync();

    // 2. Calculate Rank Stabilly
    // We cannot use InterlockedAdd. We must count how many threads 
    // *before* us (lower index) have the same digit.
    if (globalId < _NumBoids)
    {
        uint localRank = 0;
        // Naive stable scan: Loop through all predecessors.
        // Since group size is small (256), this is acceptable and robust.
        for (uint i = 0; i < id; ++i)
        {
            if (gs_Digits[i] == digit)
                localRank++;
        }

        // 3. Write to destination
        // BlockOffsets tells us where this GROUP starts writing for this DIGIT
        uint baseIndex = BlockOffsets[groupIndex * RADIX_BUCKETS + digit];
        uint finalIndex = baseIndex + localRank;

        BoidCellsTemp[finalIndex] = BoidCells[globalId];
    }
}

[numthreads(256, 1, 1)]
void BuildCellRanges(uint id : SV_DispatchThreadID)
{
    if (id >= _NumBoids) return;

    uint cell = BoidCells[id].cellIndex;

    InterlockedMin(CellStart[cell], id);
    
    uint original;
    InterlockedCompareExchange(CellEnd[cell], _NullCell, id, original);
    InterlockedMax(CellEnd[cell], id);
}

[numthreads(256,1,1)]
void UpdateBoids (uint id : SV_DispatchThreadID)
{
    if(id >= _NumBoids) return;
    Boid b = Boids[id];
    uint3 cell = CellCord(b.pos);

    float3 cohesion = 0;
    float3 alignment = 0;
    float3 separation = 0;
    int neighborCount = 0;

    for(int i = -1; i <= 1; i++)
    {
        if(!IsValidCell((int) cell.x + i)) continue;
        for(int j = -1; j <= 1; j++)
        {
            if(!IsValidCell((int) cell.y + j)) continue;
            for(int k = -1; k <= 1; k++)
            {
                if(!IsValidCell((int) cell.z + k)) continue;

                uint curCell = FlattenCord(cell + int3(i,j,k));
            
                uint start = CellStart[curCell];
                uint end = CellEnd[curCell];

                if(start == _NullCell || end == _NullCell) continue;

                for(uint cellIndex = start; cellIndex <= end; cellIndex++)
                {
                    uint boidIndex = BoidCells[cellIndex].boidIndex;

                    if(boidIndex == id) continue;

                    Boid bo = Boids[boidIndex];

                    float3 offset = bo.pos - b.pos;
                    float distSq = dot(offset, offset);

                    if(distSq > 0.00001 && distSq <= _NeighborRadius * _NeighborRadius)
                    {
                        float distance = sqrt(distSq);
                        neighborCount++;

                        cohesion += bo.pos;
                        alignment += bo.vel;

                        
                        if(distance < _SeparationDistance)
                        {
                            float3 dir = normalize(offset);
                            separation -= dir / (distance + 0.0001);
                        }
                    }

                }
            }
                

        }

    }

    if(neighborCount > 0)
    {
        float3 centerOfMass = cohesion / neighborCount;
        cohesion = normalize(centerOfMass - b.pos) * _CohesionWeight;

        float3 avgVel = alignment / neighborCount;
        alignment = normalize(avgVel) * _AlignmentWeight;

        separation *= _SeparationWeight;
    }

    float3 acceleration = cohesion + alignment + separation;

    b.vel += acceleration * _DeltaTime;

    float speed = length(b.vel);
    if(speed > _MaxSpeed)
    {
        b.vel = normalize(b.vel) * _MaxSpeed;
    }
    else if (speed < _MinSpeed)
    {
        b.vel = normalize(b.vel) * _MinSpeed;
    }

    b.pos += b.vel * _DeltaTime;

    if(b.pos.x < 0 || b.pos.x >= 1) { b.vel.x *= -1; b.pos.x = clamp(b.pos.x, 0, .9999); }
    if(b.pos.y < 0 || b.pos.y >= 1) { b.vel.y *= -1; b.pos.y = clamp(b.pos.y, 0, .9999); }
    if(b.pos.z < 0 || b.pos.z >= 1) { b.vel.z *= -1; b.pos.z = clamp(b.pos.z, 0, .9999); }

    Boids[id] = b;

    uint2 uv = uint2(id % _TexWidth, id / _TexWidth);

    PositionMap[uv] = float4(b.pos, 1.0);
    VelocityMap[uv] = float4(b.vel, 1.0);
}