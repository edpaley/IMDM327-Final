#pragma kernel RadixScatterStable
#pragma kernel BuildCellRanges

struct Boid
{
    float2 pos;
    float2 vel;
};

struct BoidCell
{
    uint boidIndex;
    uint cellIndex;
};

#define RADIX_BITS 3
#define RADIX_BUCKETS (1 << RADIX_BITS) // = 8
#define RADIX_MASK (RADIX_BUCKETS - 1) // = 7


RWStructuredBuffer<uint> CellStart;
RWStructuredBuffer<uint> CellEnd;
RWStructuredBuffer<uint> CellBucketCounts;

RWStructuredBuffer<Boid> Boids;
RWStructuredBuffer<BoidCell> BoidCells;
RWStructuredBuffer<BoidCell> BoidCellsTemp;

RWStructuredBuffer<uint> BucketCounts;   // 8 counters
RWStructuredBuffer<uint> BucketCounters; //atomic counters for scatter
RWStructuredBuffer<uint> BucketOffsets;  // prefix-summed offsets
RWStructuredBuffer<uint> BlockCounts;
RWStructuredBuffer<uint> BlockOffsets;

groupshared uint localCounts[RADIX_BUCKETS];
groupshared uint localCounts2[RADIX_BUCKETS];


uint _Shift;

uint _NumBoids;
uint _NumGroups;
uint _NumCells;
uint _NullCell;
float _CellSize;
float _CellSeats;



[numthreads(256, 1, 1)]
void AssignCells(uint id : SV_DispatchThreadID)
{
    if(id >= _NumBoids) return;

    Boid b = Boids[id];

    int2 cellCord= int2(floor(b.pos / _CellSize));

    cellCord.x = clamp(cellCord.x, 0, _CellSeats - 1);
    cellCord.y = clamp(cellCord.y, 0, _CellSeats - 1);

    uint flattenedCord = (cellCord.x) + (cellCord.y * _CellSeats);

    BoidCells[id].boidIndex = id;
    BoidCells[id].cellIndex = flattenedCord;
}

[numthreads(16, 1, 1)]
void ClearCells(uint id : SV_DispatchThreadID)
{
    if(id >= _NumCells) return;
    CellStart[id] = _NullCell;
    CellEnd[id] = _NullCell;
}


[numthreads(RADIX_BUCKETS,1,1)]
void RadixClear (uint id : SV_DispatchThreadID)
{
    if (id >= RADIX_BUCKETS) return;
    BucketCounts[id] = 0;
    BucketCounters[id] = 0;
    BucketOffsets[id] = 0;
    BlockCounts[id] = 0;
    BlockOffsets[id] = 0;
}


