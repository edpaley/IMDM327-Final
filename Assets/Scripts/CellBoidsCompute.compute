[numthreads(256,1,1)]
void RadixBlockHistogram(uint id : SV_GroupThreadID, uint3 g : SV_GroupID, uint3 dispatchId : SV_DispatchThreadID)
{
    uint globalId = dispatchId.x;

    for (uint i = id; i < RADIX_BUCKETS; i += 256)
        localCounts[i] = 0;
    GroupMemoryBarrierWithGroupSync();

    if (globalId < _NumBoids)
    {
        uint cell = BoidCells[globalId].cellIndex;
        uint digit = (cell >> _Shift) & RADIX_MASK;
        InterlockedAdd(localCounts[digit], 1);
    }
    GroupMemoryBarrierWithGroupSync();


    if (id == 0)
    {
        uint baseIndex = g.x * RADIX_BUCKETS;
        for (uint b = 0; b < RADIX_BUCKETS; ++b)
            BlockCounts[baseIndex + b] = localCounts[b];
    }
}

[numthreads(1,1,1)]
void RadixPrefixSum(uint id : SV_DispatchThreadID)
{
    uint globalOffset = 0;

    for (uint group = 0; group < _NumGroups; ++group)
    {
        uint base = group * RADIX_BUCKETS;

        for (uint digit = 0; digit < RADIX_BUCKETS; ++digit)
        {
            uint count = BlockCounts[base + digit];

            BlockOffsets[base + digit] = globalOffset;
            globalOffset += count;
        }
    }
}

